{
  "compilerOptions": {
    "rootDir": "TypeScript",
    "outDir": "Content/JavaScript",
    "module": "commonjs",
    "target": "esnext",
    "moduleResolution": "node10",
    "typeRoots": [
      "Typing",
      "./node_modules/@types"
    ],
    "sourceMap": true,
    "jsx": "react",
    "experimentalDecorators": true,
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true
  },
  "include": [
    "TypeScript/**/*"
  ],
}