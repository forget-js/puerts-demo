# -----------------------------------------------------------------------------
# Unreal Engine — 生成物与本地缓存（勿提交）
# -----------------------------------------------------------------------------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
*.sln

# 打包 / 平台产物（按需增删平台目录名）
Android_ASTC/
IOS/
Packaged/
Dist/

# 旧版或派生资源目录（若未使用可删此行）
Cooked/

# -----------------------------------------------------------------------------
# 崩溃与日志
# -----------------------------------------------------------------------------
Crashes/
Logs/
*.log

# -----------------------------------------------------------------------------
# IDE / 编辑器（个人与缓存）
# -----------------------------------------------------------------------------
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/
*.code-workspace
.history/

# Visual Studio 本地数据库（C++）
*.VC.db
*.VC.VC.opendb
*.opensdf
*.sdf
*.suo
*.user
*.userosscache

# -----------------------------------------------------------------------------
# 操作系统杂项
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Puerts — V8 第三方预编译（体积大，勿提交；见 README「Git：.gitignore」）
# -----------------------------------------------------------------------------
Plugins/Puerts/ThirdParty/v8_9.4.146.24/

# -----------------------------------------------------------------------------
# Puerts — Node / npm
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/

# -----------------------------------------------------------------------------
# Puerts — 仅忽略项目根目录下由工具生成的 TS 声明（勿用裸 Typing，否则
# 会误匹配 Plugins/Puerts/Typing 等插件自带目录）
# -----------------------------------------------------------------------------
/Typing/

# -----------------------------------------------------------------------------
# PuertsMixinAutomation — 可由 Manifest 派生的生成文件（降低多人合并冲突）
# 首次克隆或清理后请先执行：`npm install` → `npm run gen:blueprint-catalog` → `npm run gen:mixin-index`
# 注意：blueprint-manifest.json 是协同状态文件，建议纳入版本管理，不在此忽略
# -----------------------------------------------------------------------------
/TypeScript/Blueprints/_generated/BlueprintCatalog.ts
/TypeScript/Mixins/_generated/mixin-imports.ts
/TypeScript/Mixins/_generated/mixin-imports.shared.ts
/TypeScript/Mixins/_generated/mixin-imports.client.ts
/TypeScript/Mixins/_generated/mixin-imports.server.ts

# 本地开发配置覆盖（复制 Config/Env/config.dev.example.ts 为 config.dev.ts）
/TypeScript/Config/Env/config.dev.ts

# .NET / UBT 插件（如 CSharpParamDefaultValueMetas）构建产物
**/obj/
**/bin/
*.csproj.user

# -----------------------------------------------------------------------------
# 可选：若以 TypeScript 为唯一脚本源、由 CI/本地 tsc 产出 Content/JavaScript，
# 可取消下面注释，避免把编译结果提交进仓库
# -----------------------------------------------------------------------------
/Content/JavaScript/**/*.js
/Content/JavaScript/**/*.js.map
